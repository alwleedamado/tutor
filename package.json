{
  "name": "rust-mastery-offline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Fully offline desktop learning environment for Rust, Vue 3 and Tauri v2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/generate-icon.mjs",
    "tauri": "tauri",
    "verify": "npm run typecheck && npm run test && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "marked": "^12.0.2",
    "monaco-editor": "^0.52.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.5.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/test-utils": "^2.4.4",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "vue-tsc": "^2.1.6"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "@tailwindcss/oxide@4.3.3": true,
    "vue-demi@0.14.10": true
  }
}
